# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/medicalai

# Enhanced AI Service Configuration
USE_PYTHON_SERVICE=true

# Ollama Models (make sure these models are installed locally)
OLLAMA_MEDICAL_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=phi3:latest

# OpenAI Configuration (backup option)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-render-service.onrender.com/api/auth/google/callback
CLIENT_ORIGIN=https://doctalkai.vercel.app
PINECONE_API_KEY=your_pinecone_api_key_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/medicalai

# Ollama Models (make sure these models are installed locally)
OLLAMA_MEDICAL_MODEL=gemma2:1b
OLLAMA_FALLBACK_MODEL=phi3

# OpenAI Configuration (if using OpenAI instead of Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Server Configuration
PORT=5000